# Copy this file to .env before running docker compose.
# Never commit the real .env file.

DB_PASSWORD=replace_with_a_long_random_password
DB_ROOT_PASSWORD=replace_with_another_long_random_password

SYNC_TOKEN=replace_with_a_long_random_token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_random_password

# Local HTTP testing should keep this false.
# Set true after the production API is served through HTTPS.
SESSION_COOKIE_SECURE=false

# Local host port for the API/admin reverse proxy.
API_PORT=8088

# The backend imports data/competitions.json at startup when enabled.
COMPETITION_DATA_IMPORT_ENABLED=true

# Production backup container defaults.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
